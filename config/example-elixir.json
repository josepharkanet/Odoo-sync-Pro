{
  "_comment": "EXAMPLE config — placeholder values. Real warehouse/zone/cutoff data comes from the owner (checklist B).",
  "timezone": "Asia/Dubai",
  "weekend": [5, 6],
  "holidays": ["2026-12-02", "2026-12-03"],
  "cutoffTime": "16:00",
  "handlingDays": 0,

  "warehouses": [
    { "id": "ajman", "name": "Ajman", "shopifyLocationId": "gid://shopify/Location/PLACEHOLDER_AJMAN" },
    { "id": "dubai", "name": "Dubai", "shopifyLocationId": "gid://shopify/Location/PLACEHOLDER_DUBAI" }
  ],

  "zones": [
    {
      "id": "ajman",
      "name": "Ajman",
      "match": { "emirate": ["Ajman"] },
      "routes": [
        { "warehouse": "ajman", "promise": "same-day" },
        { "warehouse": "dubai", "promise": { "type": "days", "days": 2 } }
      ]
    },
    {
      "id": "dubai",
      "name": "Dubai",
      "match": { "emirate": ["Dubai"] },
      "routes": [
        { "warehouse": "dubai", "promise": "same-day" },
        { "warehouse": "ajman", "promise": { "type": "days", "days": 1 } }
      ]
    },
    {
      "id": "other-uae",
      "name": "Other UAE",
      "default": true,
      "match": { "emirate": ["Sharjah", "Abu Dhabi", "Ras Al Khaimah", "Fujairah", "Umm Al Quwain"] },
      "routes": [
        { "warehouse": "dubai", "promise": { "type": "days", "days": 2 } },
        { "warehouse": "ajman", "promise": { "type": "days", "days": 2 } }
      ]
    }
  ]
}
